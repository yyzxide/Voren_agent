# Copy values into your shell environment or an ignored .env loader.
# Never commit a real API key.
OPENAI_API_KEY=replace-me
VOREN_MODEL=replace-with-supported-model-id
# Generate once with: python3 -c "from voren.runtime.transcripts import SQLiteTranscriptStore; print(SQLiteTranscriptStore.generate_key())"
VOREN_TRANSCRIPT_KEY=replace-with-url-safe-base64-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local Web defaults to credential-free demo mode and loopback only.
# VOREN_WEB_MODE=demo
# VOREN_WEB_WORKSPACE=agentdojo
# VOREN_WEB_DATABASE=.voren/web.sqlite3
# VOREN_KNOWLEDGE_DATABASE=.voren/voren.sqlite3
# Knowledge retrieval defaults to local chunked BM25, with no API call.
# Setting dense/hybrid explicitly enables query transmission to the embedding API.
# Build the index first with: voren knowledge index --allow-embedding-api
# VOREN_KNOWLEDGE_RETRIEVAL_MODE=bm25
# Configure an independent embedding endpoint/model; chat credentials are not reused.
# VOREN_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
# VOREN_EMBEDDING_MODEL=replace-with-supported-embedding-model-id
# VOREN_EMBEDDING_API_KEY=replace-with-embedding-api-key
# VOREN_EMBEDDING_DIMENSIONS=1024
# VOREN_EMBEDDING_MAX_REQUESTS=128
# VOREN_EMBEDDING_TIMEOUT_SECONDS=10
# VOREN_MEMORY_DATABASE=.voren/voren.sqlite3
# VOREN_WEB_PROFILE_MEMORY=active
# VOREN_SKILL_DATABASE=.voren/voren.sqlite3
# VOREN_SKILL_STORE=.voren/skills
# VOREN_WEB_SKILL_ROUTING=auto
# VOREN_WEB_PORT=8080
# Google connector uses a short-lived token from the local process environment.
# GOOGLE_WORKSPACE_ACCESS_TOKEN=replace-with-short-lived-oauth-access-token
# VOREN_GOOGLE_ACCOUNT_EMAIL=you@example.com
# VOREN_GOOGLE_CALENDAR_ID=primary
# VOREN_GOOGLE_TIME_ZONE=Asia/Shanghai
